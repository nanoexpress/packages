{
  "name": "@nanoexpress/hooks",
  "version": "0.0.1",
  "description": "Hooks for nanoexpress",
  "main": "cjs/ne-hook.js",
  "module": "esm/ne-hook.js",
  "typings": "typings/ne-hook.d.ts",
  "exports": {
    "import": "./esm/ne-hook.js",
    "require": "./cjs/ne-hook.js",
    "types": "./typings/hooks.d.ts",
    "default": "./cjs/ne-hook.js"
  },
  "files": [
    "esm",
    "cjs"
  ],
  "scripts": {
    "build:cjs": "rm -rf cjs && bun build ./src/ne-hook.ts --outdir=cjs --packages=external --sourcemap=external --platform=node --format=cjs --target=node",
    "build:esm": "rm -rf esm && bun build ./src/ne-hook.ts --outdir=esm --packages=external --sourcemap=external --platform=node --format=esm --target=node",
    "build:dts": "rm -rf typings && tsc --ignoreConfig ./src/ne-hook.ts --declaration --emitDeclarationOnly --declarationDir typings --lib es2020 --types node,bun --strict --target es2020 --module esnext --moduleResolution bundler --skipLibCheck",
    "build": "bun run build:dts && bun run build:esm && bun run build:cjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "hooks",
    "use-effect",
    "use-memo"
  ],
  "author": "Davlatjon Shavkatov <opensource@dalisoft.uz>",
  "license": "Apache-2.0"
}
